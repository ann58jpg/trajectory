# Без ключа сайт работает в демо-режиме (детерминированный движок + шаблоны).
ANTHROPIC_API_KEY=
# Модель Claude для объяснений и поиска мероприятий
ANTHROPIC_MODEL=claude-sonnet-5-5
# Провайдер ИИ: anthropic | yandexgpt | gigachat | none (по умолчанию anthropic при наличии ключа)
LLM_PROVIDER=anthropic
# Заглушки для будущего внедрения (не реализованы)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
GIGACHAT_AUTH_KEY=
# hh.ru требует User-Agent вида "app/version (email)". Без него модуль сразу уходит в фолбэк.
HH_USER_AGENT=trajectory-prototype/0.1 (dev@example.com)
# Путь к SQLite
DATABASE_PATH=./data/trajectory.db
